---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const friends = [
  {
    name: 'Petdex',
    desc: 'Codex 宠物分发平台，4600+ 社区宠物包。Z-Buddy 的宠物包格式与其兼容思路一致，存量宠物生态可以直接玩。',
    url: 'https://petdex.dev/',
  },
  {
    name: 'clawd-on-desk',
    desc: '通用 Agent 桌宠项目，Z-Buddy 的架构参考与敬意来源。',
    url: 'https://github.com/rullerzhou-afk/clawd-on-desk',
  },
  {
    name: 'ZCode',
    desc: '智谱的 AI 编程工作台，Z-Buddy 依托的编程工具——桌宠感知的就是它的 Agent 状态。',
    url: 'https://zcode.z.ai/',
  },
  {
    name: 'ZCode 文档',
    desc: '插件 / Skill / Hooks 机制官方文档。Z-Buddy 插件的能力边界都定义在这里。',
    url: 'https://zcode.z.ai/cn/docs',
  },
  {
    name: 'GLM 开放平台',
    desc: '智谱大模型开放平台。Z-Buddy 规划中的聊天气泡将直连你自己的 GLM API Key。',
    url: 'https://bigmodel.cn/',
  },
];
---

<BaseLayout title={`友情链接 · Z-Buddy`} description="Z-Buddy 友情链接：宠物生态、Agent 桌宠同好与 ZCode / GLM 官方资源。">
  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">友情链接</h1>
    <p class="section-sub">宠物生态、桌宠同好与 ZCode / GLM 官方资源。</p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {friends.map((f) => (
        <a class="card group block transition-shadow hover:shadow-md" href={f.url} target="_blank" rel="noopener">
          <div class="flex items-center justify-between">
            <h2 class="font-semibold">{f.name}</h2>
            <span class="text-ink-2 transition-colors group-hover:text-zblue">↗</span>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-ink-2">{f.desc}</p>
          <p class="mt-3 truncate font-mono text-xs text-zblue group-hover:underline">{f.url}</p>
        </a>
      ))}
    </div>

    <div class="card mt-10">
      <h2 class="font-semibold">想交换友链？</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-2">
        欢迎 AI 编程工具、开源桌宠、开发者工具类站点，
        在 <a class="text-zblue underline underline-offset-2" href={`${SITE.issues}`} target="_blank" rel="noopener">GitHub Issues</a>
        里开个帖子附上你的站点与简介即可。只收录内容健康、与开发者生态相关的站点。
      </p>
    </div>
  </section>
</BaseLayout>
