---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const next = {
  tag: '开发完成 · 待发布',
  items: [
    '多会话聚合：每会话独立状态分片，桌宠按「出错 > 等审批 > 干活」优先级显示，主界面新增多会话卡片',
    '电脑操作预警：Agent 操控屏幕（computer use）时桌宠弹出红色预警气泡——点桌宠即可急刹',
    '宠物包导入：主界面一键导入文件夹宠物包（自动校验格式与重名），管理页 hover 直接播放动画',
    '体验修缮：宠物大小可调（50%–200%）、位置记忆（重启还原）、事件流自动轮转、状态切换淡入',
    '官网：宠物包规范 v1、架构与隐私等文档上线',
  ],
};

const releases = [
  {
    version: SITE.version,
    date: SITE.date,
    tag: '首个公开版本',
    items: [
      '状态联动：六态动画实时映射 Agent 生命周期（空闲 5 分钟自动睡觉）',
      '点按暂停：点桌宠 = ZCode 停手，hook 硬拦截闭环，支持命令级豁免',
      '悬浮窗：置顶无边框、点按穿透、自由拖动（拎起变黑天鹅）、多显示器与 DPI 适配',
      '托盘菜单与开机自启（安装包可选）',
      '应用内自动更新：主界面标题栏 🔄 一键升级',
      '宠物包加载器：~/.z-buddy/pets/ 外部包扫描、热切换、偏好持久化，格式兼容 hatch-pet',
      '内置原创宠物「夜羽 Yoru」（默认）「团子 Mochi」「BSOD」「Fireball」',
      'NSIS 安装包（中英双语向导）+ 便携版，仅 4.2 MB',
    ],
  },
];
---

<BaseLayout title={`更新日志 · Z-Buddy`} description="Z-Buddy 更新日志：每个版本改了什么，一目了然。">
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">更新日志</h1>
    <p class="section-sub">完整历史见 <a class="text-zblue underline underline-offset-2" href={SITE.releasesLatest} target="_blank" rel="noopener">GitHub Releases</a>。</p>

    <!-- 下个版本预告 -->
    <article class="mt-10">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h2 class="text-xl font-bold">下个版本</h2>
        <span class="rounded-full bg-zblue/10 px-2.5 py-0.5 text-xs font-medium text-zblue">{next.tag}</span>
      </div>
      <ul class="mt-4 list-disc space-y-2 pl-6 text-sm leading-7 text-ink-2">
        {next.items.map((it) => <li set:html={it} />)}
      </ul>
      <p class="mt-4 text-sm text-ink-2">装了 v{SITE.version} 的用户：发布后主界面标题栏会出现 🔄 更新按钮，点一下即可升级。</p>
    </article>

    <hr class="my-10 border-hairline" />

    {releases.map((r) => (
      <article class="mt-10">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h2 class="text-xl font-bold">v{r.version}</h2>
          <span class="rounded-full bg-soft px-2.5 py-0.5 text-xs text-ink-2">{r.tag}</span>
          <time class="text-sm text-ink-2">{r.date}</time>
        </div>
        <ul class="mt-4 list-disc space-y-2 pl-6 text-sm leading-7 text-ink-2">
          {r.items.map((it) => <li set:html={it} />)}
        </ul>
        <p class="mt-4 text-sm">
          <a class="text-zblue underline underline-offset-2" href={SITE.releaseTag} target="_blank" rel="noopener">下载 v{r.version} →</a>
        </p>
      </article>
    ))}
  </section>
</BaseLayout>
