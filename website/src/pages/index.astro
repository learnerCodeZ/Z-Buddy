---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMock from '../components/HeroMock.astro';
import { SITE, releaseAsset, withBase } from '../data/site';

const bp = import.meta.env.BASE_URL;

const sellingPoints = [
  {
    icon: '👀',
    title: '看得见的状态',
    desc: 'Agent 在后台干活时，桌宠把状态演给你看：干活打字、出错冒汗、完成庆祝、深夜睡觉——AI 在干什么，一眼可知。',
  },
  {
    icon: '⏸️',
    title: '点一下就暂停',
    desc: '点团子 = ZCode 停手，再点恢复。通过 hook 硬拦截实现，不是装饰按钮——人随时插队，AI 让位。',
  },
  {
    icon: '🧩',
    title: '宠物包即装即换',
    desc: '一张精灵图 + 一个 JSON 就是新宠物，丢进 ~/.z-buddy/pets/ 立刻换宠；格式兼容 Codex hatch-pet 生态思路。',
  },
];

const features = [
  { icon: '🎭', title: '六种状态全覆盖', desc: 'idle / thinking / working / 等待审批 / 出错 / 深夜睡觉，动画实时映射 Agent 生命周期。' },
  { icon: '🪟', title: '悬浮拖动', desc: '置顶无边框悬浮窗，点按穿透（不挡鼠标）、自由拖动、多显示器与 DPI 适配。' },
  { icon: '🫥', title: '托盘与开机自启', desc: '系统托盘菜单：显示/隐藏、切换宠物、退出；支持开机自启，随叫随到。' },
  { icon: '📦', title: '宠物包加载器', desc: '外部宠物包目录扫描 + 热切换，偏好持久化；为宠物商店生态打好了地基。' },
  { icon: '🪶', title: '超轻量', desc: '安装包 4.2 MB、内存 ~30 MB、单进程。挂机一整天，毫无存在感。' },
  { icon: '🔒', title: '隐私优先', desc: '状态数据只写本机 ~/.z-buddy/，不上传任何东西；聊天历史（规划中）也永不落盘。' },
];

const pets = [
  { name: '团子 Mochi', desc: '第一只原创宠物，程序化生成，白团子本团。', img: 'pets/mochi-loop.webp' },
  { name: '抹茶 Matcha', desc: '一行换肤命令生成的绿色团子，外部宠物包加载实测员。', img: 'pets/matcha-loop.webp' },
];

const phases = [
  { name: 'Phase 0 · 技术验证', status: 'done', desc: 'hooks 事件流、点按暂停闭环、打断自愈、Tauri 选型' },
  { name: 'Phase 1 · MVP', status: 'doing', desc: '状态联动 / 悬浮暂停 / 托盘自启 / 宠物包加载 —— 已达成第一里程碑' },
  { name: 'Phase 2 · 生态与可视化', status: 'todo', desc: 'hatch 生成宠物、GLM 对话气泡、电脑操作可视化、任务气泡' },
  { name: 'Phase 3 · 护城河', status: 'todo', desc: '人机接力、审批桌面卡片、子代理多宠物、养成系统' },
];

const faqs = [
  {
    q: '和 Codex 的宠物模式是什么关系？',
    a: 'Codex Pet Mode 是灵感和敬意来源。Z-Buddy 是为 ZCode 而生的独立开源实现：宠物包格式参考其开放的精灵图思路，并计划做兼容，让存量宠物生态直接可用。',
  },
  {
    q: '收费吗？',
    a: '免费且开源（MIT，发布前确定）。运行中唯一的可选成本是聊天功能调用 GLM API 的费用——用的是你自己配置的 Key，与本项目无关。',
  },
  {
    q: '它会读我的代码、上传数据吗？',
    a: '不上传任何数据。插件只把 Agent 状态（如 working / error）写到本机 ~/.z-buddy/state.json，桌宠读取它来播放动画，全程不出你的电脑。',
  },
  {
    q: '支持 macOS / Linux 吗？',
    a: '目前 Windows 优先（10/11 x64）。应用基于 Tauri，跨平台在技术上可行，排在 Windows 版打磨稳定之后，具体排期待定。',
  },
];
---

<BaseLayout>
  <!-- ① Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_50%_at_50%_0%,rgba(0,113,227,0.07),transparent)]"></div>
    <div class="mx-auto max-w-6xl px-4 pb-16 pt-14 sm:px-6 sm:pt-20">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="text-sm font-medium text-ink-2">为 ZCode 而生的桌宠</p>
          <h1 class="mt-3 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
            代码在跑，<span class="grad-text">Z-Buddy</span> 在陪。
          </h1>
          <p class="mt-5 max-w-lg text-base leading-relaxed text-ink-2 sm:text-lg">
            一只挂在桌面角落的像素小宠物：ZCode 干活时它打字，出错时它冒汗，完成时它庆祝，深夜它会冒 Zzz 睡着。点它一下，随时让 AI 停一停。
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a class="btn-primary" href={releaseAsset(SITE.assets.setup)}>立即下载 Z-Buddy</a>
            <a class="btn-secondary" href="#download">查看全部下载</a>
          </div>
          <p class="mt-4 text-xs text-ink-2">
            v{SITE.version} · Windows 10/11 · 免费 · 仅 4.2 MB ·
            <a class="underline underline-offset-2 hover:text-ink" href={SITE.repo} target="_blank" rel="noopener">GitHub</a>
          </p>
        </div>
        <HeroMock />
      </div>
    </div>
  </section>

  <!-- ② 三大卖点 -->
  <section class="border-t border-hairline bg-elevated py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="section-title text-center">为什么养一只 Z-Buddy</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {sellingPoints.map((p) => (
          <div class="card">
            <div class="text-3xl">{p.icon}</div>
            <h3 class="mt-4 text-lg font-semibold">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-2">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ③ 功能网格 -->
  <section id="features" class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="section-title">产品能力</h2>
      <p class="section-sub">v{SITE.version} 已实现的能力如下；更多在路上的，见下方路线图。</p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="card transition-shadow hover:shadow-md">
            <div class="flex items-center gap-3">
              <span class="text-2xl">{f.icon}</span>
              <h3 class="font-semibold">{f.title}</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink-2">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ④ 宠物秀 -->
  <section class="border-t border-hairline bg-elevated py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="section-title">认识一下家里的宠物</h2>
      <p class="section-sub">全部原创程序化生成，版权干净。想自己捏一只？<a class="text-zblue underline underline-offset-2" href={`${bp}/docs/faq/`}>看宠物包玩法</a>。</p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {pets.map((p) => (
          <div class="card flex items-center gap-6">
            <img src={withBase(p.img)} alt={`${p.name} 循环动画`} class="pixelated h-28 w-28 shrink-0" width="112" height="112" />
            <div>
              <h3 class="text-lg font-semibold">{p.name}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-2">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="mt-6 text-center text-sm">
        <a class="text-zblue underline underline-offset-2" href={`${bp}/gallery/`}>去宠物画廊看看 →</a>
      </p>
    </div>
  </section>

  <!-- ⑤ 路线图 -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="section-title">路线图</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {phases.map((p) => (
          <div class:list={['card', p.status === 'doing' && 'ring-2 ring-zblue/40']}>
            <p class="text-xs font-medium tracking-wider text-ink-2">{p.name}</p>
            <p class="mt-3 text-sm leading-relaxed text-ink-2">{p.desc}</p>
            <p class="mt-4 text-xs font-semibold">
              {p.status === 'done' && <span class="text-ok">✅ 已完成</span>}
              {p.status === 'doing' && <span class="text-zblue">🔄 进行中</span>}
              {p.status === 'todo' && <span class="text-ink-2">⬜ 计划中</span>}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑥ 全部下载 -->
  <section id="download" class="border-t border-hairline bg-elevated py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="section-title">全部下载</h2>
      <p class="section-sub">v{SITE.version} · {SITE.date} · <a class="text-zblue underline underline-offset-2" href={SITE.releasesLatest} target="_blank" rel="noopener">前往 GitHub Releases</a></p>
      <div class="mt-8 divide-y divide-hairline overflow-hidden rounded-2xl border border-hairline bg-card">
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-4">
          <div>
            <p class="font-medium">Windows 安装包（推荐）</p>
            <p class="mt-0.5 text-xs text-ink-2">NSIS 向导 · 自选路径 · 支持开机自启</p>
          </div>
          <a class="shrink-0 font-mono text-sm text-zblue underline underline-offset-2" href={releaseAsset(SITE.assets.setup)}>{SITE.assets.setup}</a>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-4">
          <div>
            <p class="font-medium">Windows 便携版</p>
            <p class="mt-0.5 text-xs text-ink-2">解压即用 · 不写注册表</p>
          </div>
          <a class="shrink-0 font-mono text-sm text-zblue underline underline-offset-2" href={releaseAsset(SITE.assets.portable)}>{SITE.assets.portable}</a>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-4">
          <p class="font-medium">SHA256 校验文件</p>
          <a class="shrink-0 font-mono text-sm text-zblue underline underline-offset-2" href={releaseAsset(SITE.assets.sha256)}>{SITE.assets.sha256}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ⑦ FAQ + 底部 CTA -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="section-title text-center">常见问题</h2>
      <div class="mt-10 divide-y divide-hairline rounded-2xl border border-hairline bg-card px-6">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none font-medium marker:hidden">
              <span class="inline-flex items-center gap-2">{f.q}<span class="ml-auto text-ink-2 transition-transform group-open:rotate-45">＋</span></span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink-2">{f.a}</p>
          </details>
        ))}
      </div>
      <div class="mt-14 text-center">
        <h3 class="text-2xl font-bold">给 ZCode 配一只桌宠</h3>
        <p class="mt-2 text-sm text-ink-2">两分钟装好，不满意拖进回收站，不留痕迹。</p>
        <a class="btn-primary mt-6" href={`${bp}/download/`}>立即下载 Z-Buddy</a>
      </div>
    </div>
  </section>
</BaseLayout>
