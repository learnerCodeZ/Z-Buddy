---
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/700.css';
import '@fontsource/geist-mono/400.css';
import '../styles/global.css';
import { SITE, withBase } from '../data/site';

const bp = import.meta.env.BASE_URL;
const nav = [
  { href: `${bp}/#features`, label: '功能' },
  { href: `${bp}/docs/quick-start/`, label: '文档' },
  { href: `${bp}/changelog/`, label: '更新日志' },
  { href: `${bp}/gallery/`, label: '宠物画廊' },
];

interface Props {
  title?: string;
  description?: string;
}
const { title = SITE.title, description = SITE.description } = Astro.props;
const ogImage = withBase('og.png');
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-white font-sans text-ink antialiased">
    <!-- 公告条（对齐 ZCode 官网） -->
    <div class="bg-ink px-4 py-2 text-center text-xs text-white/90 sm:text-sm">
      🎉 v{SITE.version} 发布：状态联动 · 点按暂停 · 宠物包加载 ——
      <a href={`${bp}/changelog/`} class="underline underline-offset-2 hover:text-white">看更新了什么</a>
    </div>

    <!-- 顶部导航 -->
    <header class="sticky top-0 z-50 border-b border-hairline bg-white/80 backdrop-blur">
      <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href={bp + '/'} class="flex items-center gap-2 font-semibold">
          <img src={withBase('pets/mochi-idle.webp')} alt="" class="pixelated h-7 w-7" />
          <span>Z-Buddy</span>
        </a>
        <div class="hidden items-center gap-7 text-sm text-ink-2 md:flex">
          {nav.map((n) => <a href={n.href} class="transition-colors hover:text-ink">{n.label}</a>)}
          <a href={SITE.repo} class="transition-colors hover:text-ink" target="_blank" rel="noopener">GitHub</a>
        </div>
        <a href={`${bp}/download/`} class="rounded-full bg-zblue px-4 py-1.5 text-sm font-medium text-white transition-colors hover:bg-zblue-hover">立即下载</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <!-- 页脚（对齐 ZCode 的版权条式布局） -->
    <footer class="border-t border-hairline bg-mist-2">
      <div class="mx-auto max-w-6xl px-4 py-10 text-xs leading-6 text-ink-2 sm:px-6">
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
          <span class="font-medium text-ink">© 2026 learnerCodeZ · Z-Buddy</span>
          <a href={SITE.repo} class="hover:text-ink" target="_blank" rel="noopener">GitHub</a>
          <a href={SITE.issues} class="hover:text-ink" target="_blank" rel="noopener">Issues 反馈</a>
          <a href={`${SITE.repo}/blob/main/LICENSE`} class="hover:text-ink" target="_blank" rel="noopener">License (MIT)</a>
          <a href={`${bp}/docs/quick-start/`} class="hover:text-ink">文档</a>
        </div>
        <p class="mt-3">
          Z-Buddy 是独立的个人开源项目，与 Z.ai / 智谱无隶属关系；Codex 是 OpenAI 的商标，此处仅作技术对照。
          宠物形象为本项目原创美术，感谢灵感来源
          <a href="https://github.com/rullerzhou-afk/clawd-on-desk" class="underline underline-offset-2 hover:text-ink" target="_blank" rel="noopener">clawd-on-desk</a>
          与 Codex Pet Mode。
        </p>
      </div>
    </footer>
  </body>
</html>
