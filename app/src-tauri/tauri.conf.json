{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Z-Buddy",
  "version": "0.1.0",
  "identifier": "com.learnercodez.zbuddy",
  "build": {
    "frontendDist": "../src"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://learnercodez.github.io/Z-Buddy/latest.json",
        "https://github.com/learnerCodeZ/Z-Buddy/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxOTUyRjQzOTZFNzhFRTYKUldUbWp1ZVdReStWOFFkRkN0K2Q3RkkxZmpxcnpZMlhKYzc2b1NneE4wVU5PNVVoNFUva2tDTWQK"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "z-buddy-pet",
        "url": "/pet/index.html",
        "width": 240,
        "height": 340,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.z-buddy/pets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
